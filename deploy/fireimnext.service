[Unit]
Description = FireIM Frontend (Next.js dev)

After = network.target

[Service]
# 运行身份
User = ou251
Group = ou251

# 工作目录
WorkingDirectory = /home/ou251/.project/fireim/frontend

# PATH 需包含 nvm 的 node 目录（npm 脚本 shebang 为 /usr/bin/env node，systemd 默认 PATH 找不到 node）
Environment = "PATH=/home/ou251/.nvm/versions/node/v24.14.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 启动命令（dev 模式：热更新，改代码即时生效；-H 0.0.0.0 保持局域网可访问）
# node/npm 用绝对路径，systemd 环境 PATH 不含 nvm
ExecStart = /home/ou251/.nvm/versions/node/v24.14.0/bin/npm run dev -- -H 0.0.0.0

# 退出处理
KillMode = mixed
KillSignal = SIGTERM
TimeoutStopSec = 1

# 重启策略
Restart = on-failure
RestartSec = 3

# 日志
StandardOutput = journal
StandardError = journal

[Install]
# 开机自启
WantedBy = multi-user.target
